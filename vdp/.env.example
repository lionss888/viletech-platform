# Copy to vdp/.env (gitignored). Never commit secrets.
# If an API key was pasted into chat/slack — rotate it in Yandex Cloud first.

EXTRACTION_PRIMARY=yandex
EXTRACTION_FALLBACK=fixture
EXTRACTION_SHADOW_URL=
EXTRACTION_GOLD_DIR=/var/vdp/extraction-gold

# Required for live Yandex PRIMARY (all three):
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# e.g. gpt://<folder_id>/yandexgpt-lite
YANDEX_MODEL_URI=

# Own / Ollama (separate plan; leave empty for Yandex wire)
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=qwen2.5:3b
# OWN_MODEL_PATH=
