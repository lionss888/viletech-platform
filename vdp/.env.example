# Copy to vdp/.env (gitignored). Never commit secrets.
# If an API key was pasted into chat/slack — rotate it in Yandex Cloud first.

EXTRACTION_PRIMARY=fixture
EXTRACTION_FALLBACK=fixture
EXTRACTION_SHADOW_URL=
EXTRACTION_GOLD_DIR=/var/vdp/extraction-gold

# Live Yandex PRIMARY (all three required):
# EXTRACTION_PRIMARY=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# e.g. gpt://<folder_id>/yandexgpt-lite
YANDEX_MODEL_URI=

# Own / Ollama (dev/canary). Models live on host Ollama store — not in extraction image.
# One-time: make extraction-ollama-ensure
# EXTRACTION_PRIMARY=own
# EXTRACTION_FALLBACK=yandex
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OWN_FEW_SHOT_K=3
# OWN_MODEL_PATH=./extraction/artifacts/own-cpu-eval-0

# manager-ops (roster + behavioral). Optional profile — not in default compose-up.
# COMPOSE_PROFILES=manager-ops
# MANAGER_OPS_URL=http://localhost:8094
# MANAGER_OPS_HEALTH_URL=http://localhost:8094/health
# MANAGER_OPS_CHAT_IDS=-1001234567890
# MANAGER_OPS_DATA_DIR=./.manager-ops-data
# MANAGER_OPS_EXPORT_DIR=./.manager-ops-export
# TELEGRAM_BOT_TOKEN=
# Export dataset: make manager-ops-export

# Root dashboard probes (core BFF). Defaults match local ports; compose overrides to service DNS.
# DOCS_HEALTH_URL=http://localhost:8090/health
# MAIL_HEALTH_URL=http://localhost:8091/health
# SMS_HEALTH_URL=http://localhost:8092/health
