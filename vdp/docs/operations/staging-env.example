# Staging environment example (copy to secret store or .env.staging — do not commit secrets)

# Phase 3 paths. Local compose staging-like uses published ports below. Remote alpha or staging
# uses HTTPS core and loopback hub or docs or mail on the VM (not public). Empty DOCS_URL or
# MAIL_URL keeps hub fixture stubs — do not claim live vendor path without URL.

# --- Local compose (make staging-smoke defaults) ---
CORE_URL=http://127.0.0.1:8080
HUB_URL=http://127.0.0.1:8081
DOCS_URL=http://127.0.0.1:8090/generate
MAIL_URL=http://127.0.0.1:8091/notify
SMS_URL=http://127.0.0.1:8092/notify

# --- Remote staging or alpha (fill after bootstrap-host; secrets stay on VM .env.deploy) ---
# CORE_URL=https://alpha.vedy.io
# HUB_URL=http://127.0.0.1:8081
# DOCS_URL=http://127.0.0.1:8090/generate
# MAIL_URL=http://127.0.0.1:8091/notify
# SMS_URL=http://127.0.0.1:8092/notify

# Telegram platform bot (optional). Empty token → hub fixture.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vdp_notify_bot

EXTRACTION_URL=http://127.0.0.1:8093

# Document extraction (side-path). Compose: http://extraction:8093/recognize
OCR_URL=http://127.0.0.1:8093/recognize
OCR_TIMEOUT_MS=180000
GATEWAY_TIMEOUT=180
# Docling pilot PRIMARY (default local compose). Yandex not PRIMARY on this pilot.
EXTRACTION_PRIMARY=docling
EXTRACTION_FALLBACK=fixture
EXTRACTION_DOCLING_URL=http://docling:5001
EXTRACTION_SHADOW_URL=
EXTRACTION_GOLD_DIR=/var/vdp/extraction-gold
# Live commercial (not pilot): EXTRACTION_PRIMARY=yandex + all YANDEX_* in secret store (not git).
# YANDEX_API_KEY=   # rotate if ever leaked; never commit
# YANDEX_FOLDER_ID=
# YANDEX_MODEL_URI=gpt://<folder_id>/yandexgpt-lite
# Own CPU (host Ollama; make extraction-ollama-ensure once):
# EXTRACTION_PRIMARY=own
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OWN_FEW_SHOT_K=3
# OWN_MODEL_PATH=

# 1C / Diadoc — optional for import pilot. Empty URL → hub fixture or smart stub.
# Do not claim vendor-ready without URL. Manual Diadoc path remains in UI.
# ONEC_URL=https://1c.example.com/vdp
# DIADOC_URL=https://diadoc.example.com/vdp

# Optional bank channel webhook receiver for RD9 manual smoke
# BANK_WEBHOOK_URL=https://bank-receiver.example.com/vdp/events

ENVIRONMENT=staging
JWT_SECRET=replace-with-rotated-core-secret
HUB_SHARED_SECRET=replace-with-rotated-s2s-secret

DATABASE_URL=postgres://vdp_core:***@db.example.com:5432/vdp_core?sslmode=require
HUB_DATABASE_URL=postgres://vdp_hub:***@db.example.com:5432/vdp_hub?sslmode=require
