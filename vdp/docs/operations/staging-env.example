# Staging environment example (copy to secret store / .env.staging — do not commit secrets)

CORE_URL=https://staging-core.example.com
HUB_URL=https://staging-hub.example.com

# Hub adapters — required for real document/mail path (see staging-checklist.md)
# Compose dev: http://127.0.0.1:8090/generate (docs-service in docker-compose.yml)
DOCS_URL=https://docs-service.example.com/generate
# Compose dev: http://127.0.0.1:8091/notify (mail-gateway local provider)
MAIL_URL=https://mail-gateway.example.com/notify
# Compose dev: http://127.0.0.1:8092/notify (sms-gateway local provider)
SMS_URL=https://sms-gateway.example.com/notify

# Telegram platform bot (optional). Empty token → hub fixture.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vdp_notify_bot

EXTRACTION_URL=http://127.0.0.1:8093

# Document extraction (side-path). Compose: http://extraction:8093/recognize
OCR_URL=http://127.0.0.1:8093/recognize
# Live commercial: EXTRACTION_PRIMARY=yandex + all YANDEX_* in secret store (not git).
EXTRACTION_PRIMARY=fixture
EXTRACTION_FALLBACK=fixture
EXTRACTION_SHADOW_URL=
EXTRACTION_GOLD_DIR=/var/vdp/extraction-gold
# YANDEX_API_KEY=   # rotate if ever leaked; never commit
# YANDEX_FOLDER_ID=
# YANDEX_MODEL_URI=gpt://<folder_id>/yandexgpt-lite
# Own CPU (host Ollama; make extraction-ollama-ensure once):
# EXTRACTION_PRIMARY=own
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
# OWN_FEW_SHOT_K=3
# OWN_MODEL_PATH=

# 1C / Diadoc — optional. Empty URL → hub fixture / smart stub. Do not claim vendor-ready.
# ONEC_URL=https://1c.example.com/vdp
# DIADOC_URL=https://diadoc.example.com/vdp

# Optional bank channel webhook receiver for RD9 manual smoke
BANK_WEBHOOK_URL=https://bank-receiver.example.com/vdp/events

ENVIRONMENT=staging
JWT_SECRET=replace-with-rotated-core-secret
HUB_SHARED_SECRET=replace-with-rotated-s2s-secret

DATABASE_URL=postgres://vdp_core:***@db.example.com:5432/vdp_core?sslmode=require
HUB_DATABASE_URL=postgres://vdp_hub:***@db.example.com:5432/vdp_hub?sslmode=require
