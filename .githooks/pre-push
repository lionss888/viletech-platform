#!/usr/bin/env bash
# Pre-push: path-aware local PR gate, then optional management Telegram notify.
# Hard-blocks on red gate. Bypass only: SKIP_PREPUSH_GATE=1
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GATE="$ROOT/vdp/scripts/prepush-gate.sh"
NOTIFY="$ROOT/vdp/scripts/notify-mgmt.sh"

# Capture push refs from stdin before running gate (gate may take minutes).
PUSH_LINES="$(cat || true)"

chmod +x "$GATE" 2>/dev/null || true
"$GATE"

# Notify after successful gate (best-effort).
if [ ! -x "$NOTIFY" ]; then
  exit 0
fi

if [ -f ~/.vdp-intake/env ]; then
  set +u
  # shellcheck disable=SC1090
  source ~/.vdp-intake/env
  set -u
fi

if [ -z "${MGMT_NOTIFY_TOKEN:-}${TELEGRAM_INTAKE_TOKEN:-}" ]; then
  exit 0
fi

printf '%s\n' "$PUSH_LINES" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  BRANCH="${remote_ref#refs/heads/}"
  REVISION="$(git -C "$ROOT" rev-parse --short "$local_sha" 2>/dev/null || echo "$local_sha")"
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    COMMITS_COUNT="$(git -C "$ROOT" rev-list --count "$local_sha" 2>/dev/null || echo 0)"
    BODY="Новая ветка: $BRANCH ($COMMITS_COUNT коммитов)"
  else
    COMMITS_COUNT="$(git -C "$ROOT" rev-list --count "$remote_sha..$local_sha" 2>/dev/null || echo 0)"
    BODY="Push в $BRANCH: $COMMITS_COUNT коммит(ов)"
  fi
  "$NOTIFY" \
    --kind push \
    --title "push на удалённый сервер" \
    --status success \
    --revision "$REVISION" \
    --body "$BODY" \
    || true
done

exit 0
