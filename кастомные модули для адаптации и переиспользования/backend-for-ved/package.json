{
  "name": "Fea360",
  "version": "1.0.0",
  "description": "Nest TypeScript starter repository",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "fea": "nest start --watch fea.back",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --config jest.config.js --runInBand",
    "test:e2e": "jest --config jest-e2e.config.js --runInBand",
    "test:real": "jest --config jest.real-tests.config.js --runInBand",
    "test:smoke": "jest --config jest.real-tests.config.js --testPathPattern=test/smoke --runInBand",
    "test:health": "jest --config jest.real-tests.config.js --testPathPattern=test/health --runInBand",
    "test:db-integration": "jest --config jest.real-tests.config.js --testPathPattern=test/db-integration --runInBand",
    "test:api-e2e": "jest --config jest.real-tests.config.js --testPathPattern=test/api-e2e --runInBand",
    "test:unit": "jest --config jest.config.js --testPathPattern=src/modules/diadoc",
    "check:api": "node scripts/check-api.js",
    "lint": "eslint \"./src/**/*.ts\"",
    "lint:fix": "eslint --fix \"./src/**/*.ts\"",
    "pretty": "prettier --write \"./src/**/*.ts\"",
    "prepare": "husky"
  },
