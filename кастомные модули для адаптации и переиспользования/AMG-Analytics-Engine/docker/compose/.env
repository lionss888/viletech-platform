# ========================================
# PGAdmin Configuration
# ========================================

# PGAdmin Access
PGADMIN_DEFAULT_EMAIL=admin@amg-banking.com
PGADMIN_DEFAULT_PASSWORD=N1lgpARG7vO1Qze6jxTaRg86KhRY8PMZ

# ========================================
# Application Security
# ========================================

# Django/Flask Secret Key (если используется)
SECRET_KEY=IZHzLE0fmnBb2zpujQG2vXEyaPIMcpcdU+36NJt8hHA=

# Debug Mode (в продакшене должно быть False)
DEBUG=False

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# ClickHouse Configuration (если используется)
# ========================================

CLICKHOUSE_DB=abs_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ========================================
# Logging Configuration
# ========================================

# Log Level
LOG_LEVEL=INFO

# Log File Path
LOG_FILE_PATH=./logs/amg-banking.log

# ========================================
# Security Settings
# ========================================

# Session Timeout (в секундах)
SESSION_TIMEOUT=3600

# Password Policy
MIN_PASSWORD_LENGTH=12
REQUIRE_SPECIAL_CHARS=true
REQUIRE_NUMBERS=true
REQUIRE_UPPERCASE=true

# ========================================
# Backup Configuration
# ========================================

# Backup Directory
BACKUP_DIR=./backup

# Backup Retention (в днях)
BACKUP_RETENTION_DAYS=30

# ========================================
# Monitoring Configuration
# ========================================

# Prometheus Metrics Port
METRICS_PORT=9090

# Health Check Endpoint
HEALTH_CHECK_ENDPOINT=/health

# ========================================
# Development Settings (только для разработки)
# ========================================

# Auto Reload
AUTO_RELOAD=true

# Development Server Port
DEV_PORT=8502
