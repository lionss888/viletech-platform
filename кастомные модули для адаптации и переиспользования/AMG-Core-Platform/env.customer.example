# Customer External PostgreSQL Configuration
# Copy this file to .env.customer and fill in your database details

# Primary connection string (takes precedence over individual parameters)
PG_DSN=postgresql+psycopg://APP_USER:STRONG_PASS@POSTGRES_HOST:5432/APP_DB?sslmode=require&application_name=ollama-bp-api&connect_timeout=5

# Alternative: Individual connection parameters
# PGHOST=POSTGRES_HOST
# PGPORT=5432
# PGUSER=APP_USER
# PGPASSWORD=STRONG_PASS
# PGDATABASE=APP_DB
# PGSSL=require

# Database connection pool settings
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30

# Application settings
APP_ENV=prod
HOST=0.0.0.0
PORT=8000

# Ollama settings
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1

# CORS settings
ENABLE_CORS=https://yourdomain.com

# Logging
LOG_LEVEL=INFO
REQUEST_ID_HEADER=X-Request-ID
