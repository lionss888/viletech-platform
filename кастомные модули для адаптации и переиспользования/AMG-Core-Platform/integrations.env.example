# =============================================================================
# AMG Core Platform - Integrations Environment Variables
# =============================================================================
# Скопируйте этот файл в .env и заполните актуальными данными

# =============================================================================
# STRIGA BANKING PLATFORM
# =============================================================================
# Получите API ключи на https://portal.striga.com
STRIGA_API_URL=https://api-sandbox.striga.com
STRIGA_API_KEY=your_striga_api_key_here
STRIGA_API_SECRET=your_striga_api_secret_here
STRIGA_WEBHOOK_SECRET=your_striga_webhook_secret_here
STRIGA_ENVIRONMENT=sandbox  # sandbox или production

# =============================================================================
# RAILSR BANKING API
# =============================================================================
# Получите API ключи на https://developer.railsr.com
RAILSR_API_URL=https://api.railsr.com
RAILSR_API_KEY=your_railsr_api_key_here
RAILSR_CLIENT_ID=your_railsr_client_id_here
RAILSR_CLIENT_SECRET=your_railsr_client_secret_here
RAILSR_TOKEN_URL=https://api.railsr.com/oauth/token
RAILSR_WEBHOOK_SECRET=your_railsr_webhook_secret_here
RAILSR_ENVIRONMENT=PLAY  # PLAY (sandbox) или PLAYLive (production)

# =============================================================================
# BITSO CRYPTO EXCHANGE
# =============================================================================
# Получите API ключи на https://bitso.com/api_info
BITSO_API_URL=https://api.bitso.com
BITSO_API_KEY=your_bitso_api_key_here
BITSO_API_SECRET=your_bitso_api_secret_here
BITSO_ENVIRONMENT=sandbox  # sandbox или production

# =============================================================================
# APAYLO PAYMENT API
# =============================================================================
# Получите API ключи от команды Apaylo
APAYLO_API_URL=https://api.apaylo.com
APAYLO_API_KEY=your_apaylo_api_key_here
APAYLO_MERCHANT_ID=your_apaylo_merchant_id_here
APAYLO_WEBHOOK_SECRET=your_apaylo_webhook_secret_here
APAYLO_ENVIRONMENT=sandbox  # sandbox или production

# =============================================================================
# ОБЩИЕ НАСТРОЙКИ ИНТЕГРАЦИЙ
# =============================================================================
INTEGRATIONS_LOG_LEVEL=info  # debug, info, warn, error
INTEGRATIONS_TIMEOUT=30s
INTEGRATIONS_RETRY_COUNT=3

# =============================================================================
# НАСТРОЙКИ БЕЗОПАСНОСТИ
# =============================================================================
# Секретный ключ для шифрования учетных данных (генерируйте случайно!)
INTEGRATIONS_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Включить аудит запросов (true/false)
INTEGRATIONS_AUDIT_ENABLED=true

# =============================================================================
# НАСТРОЙКИ МОНИТОРИНГА
# =============================================================================
# Интервал проверки здоровья интеграций
INTEGRATIONS_HEALTH_CHECK_INTERVAL=30s

# Включить сбор метрик
INTEGRATIONS_METRICS_ENABLED=true

# Включить трассировку запросов
INTEGRATIONS_TRACING_ENABLED=true

# =============================================================================
# НАСТРОЙКИ WEBHOOK'ОВ
# =============================================================================
# Базовый URL для webhook'ов (ваш домен)
WEBHOOK_BASE_URL=https://your-domain.com

# Таймаут для обработки webhook'ов
WEBHOOK_TIMEOUT=30s

# Количество попыток повтора webhook'ов
WEBHOOK_RETRY_ATTEMPTS=3

# =============================================================================
# НАСТРОЙКИ ДЛЯ РАЗРАБОТКИ
# =============================================================================
# Включить debug режим (только для разработки!)
INTEGRATIONS_DEBUG=false

# Использовать моки вместо реальных API (для тестирования)
INTEGRATIONS_USE_MOCKS=false

# Сохранять запросы и ответы для отладки
INTEGRATIONS_SAVE_REQUESTS=false

# Папка для сохранения логов запросов
INTEGRATIONS_REQUESTS_LOG_DIR=./logs/integrations

# =============================================================================
# ПРИМЕРЫ ЗНАЧЕНИЙ (НЕ ИСПОЛЬЗУЙТЕ В PRODUCTION!)
# =============================================================================
# STRIGA_API_KEY=sk_test_1234567890abcdef
# STRIGA_API_SECRET=sk_secret_abcdef1234567890
# RAILSR_API_KEY=rl_test_1234567890abcdef
# BITSO_API_KEY=bt_test_1234567890abcdef
# APAYLO_API_KEY=ap_test_1234567890abcdef

# =============================================================================
# ВАЖНЫЕ ЗАМЕТКИ
# =============================================================================
# 1. НИКОГДА не коммитьте .env файл с реальными ключами в Git!
# 2. Используйте разные ключи для sandbox и production окружений
# 3. Регулярно ротируйте API ключи
# 4. Храните production ключи в безопасном месте (например, AWS Secrets Manager)
# 5. Всегда используйте HTTPS для webhook'ов в production
# 6. Проверяйте подписи webhook'ов для безопасности
