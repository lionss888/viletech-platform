      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400&family=Inter+Tight:wght@400;500&display=swap');\n\n  body {\n    width: 360px;\n    height: 800px;\n    margin: 0;\n    overflow: hidden;\n    background: #f8f7fc;\n  }\n\n  .invoice-screen__roboto {\n    font-family: 'Roboto', sans-serif;\n  }\n\n  .invoice-screen__inter-tight {\n    font-family: 'Inter Tight', sans-serif;\n  }\n\n  .invoice-screen__status-icons {\n    background-color: #131332;\n    -webkit-mask: url('/api/local/images/.kombai/canvas/assets/status-icons.svg') center / 46px 46px no-repeat;\n    mask: url('/api/local/images/.kombai/canvas/assets/status-icons.svg') center / 46px 46px no-repeat;\n  }\n</style>\n<main aria-label=\"Создание платежа, шаг 1 из 7\" class=\"relative h-[800px] w-[360px] overflow-hidden bg-[#f8f7fc] text-[#131332]\" data-kid=\"1\" data-name=\"invoice payment creation screen container\">\n    <img alt=\"\" aria-hidden=\"true\" class=\"absolute inset-0 z-0 h-[800px] w-[360px]\" data-kid=\"1-1\" data-name=\"screen background decorative image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/screen-background.svg\"/>\n    <div class=\"invoice-screen__roboto absolute left-[16px] top-[10px] z-10 h-[20px] w-[29px] text-[14px] font-normal leading-5 tracking-[0.25px]\" data-kid=\"1-2\" data-name=\"status bar clock time\">\n        9:30\n    </div>\n    <div aria-label=\"Состояние сети и батареи\" class=\"invoice-screen__status-icons absolute left-[298px] top-0 z-10 h-[46px] w-[46px]\" data-kid=\"1-3\" data-name=\"network and battery status icons\" role=\"img\">\n    </div>\n    <header aria-label=\"Заголовок платежа\" class=\"absolute inset-x-0 top-0 z-10 h-[104px]\" data-kid=\"1-4\" data-name=\"header section\">\n        <div class=\"invoice-screen__inter-tight absolute left-[24px] top-[75px] h-[18px] w-[260px] text-[14px] font-medium leading-[18px]\" data-kid=\"1-4-1\" data-name=\"payment creation section title\">\n            Создание платежа\n        </div>\n        <button aria-label=\"Изменить платеж\" class=\"absolute left-[296px] top-[64px] h-[40px] w-[40px] rounded-[8px] border border-[#131332]/10 bg-transparent p-0\" data-kid=\"1-4-2\" data-name=\"edit payment button\" title=\"Изменить платеж\" type=\"button\">\n            <img alt=\"\" aria-hidden=\"true\" class=\"absolute left-[13px] top-[12px] h-[15px] w-[15px]\" data-kid=\"1-4-2-1\" data-name=\"edit pencil icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/edit-pencil.svg\"/>\n        </button>\n    </header>\n    <section aria-labelledby=\"invoice-title\" class=\"absolute left-0 top-0 z-10\" data-kid=\"1-5\" data-name=\"payment title section\">\n        <h1 class=\"invoice-screen__inter-tight absolute left-[12px] top-[116px] m-0 w-[250px] text-[36px] font-normal leading-[39.6px] tracking-[-0.36px]\" data-kid=\"1-5-1\" data-name=\"main page headline text\" id=\"invoice-title\">\n            Инвойс\n            <br data-kid=\"1-5-1-1\" data-name=\"headline line break\"/>\n            и контракт\n        </h1>\n        <p class=\"invoice-screen__inter-tight absolute left-[12px] top-[208px] m-0 h-[20px] w-[250px] text-[14px] font-normal leading-5 text-[rgba(35,26,65,0.4)]\" data-kid=\"1-5-2\" data-name=\"process progress step indicator\">\n            Шаг 1 из 7\n        </p>\n    </section>\n    <form aria-label=\"Документы для платежа\" class=\"absolute inset-0 z-10\" data-kid=\"1-6\" data-name=\"payment document upload form\">\n        <div class=\"invoice-screen__inter-tight absolute left-[12px] top-[479px] h-[21px] w-[336px] text-[16px] font-normal leading-[21px]\" data-kid=\"1-6-1\" data-name=\"upload instructions text\">\n            Загрузите имеющиеся документы:\n        </div>\n        <label class=\"absolute left-[12px] top-[524px] block h-[120px] w-[164px] rounded-[12px] bg-[rgba(28,16,68,0.05)]\" data-kid=\"1-6-2\" data-name=\"invoice file upload drop zone\" for=\"invoice-upload\">\n            <input accept=\"application/pdf\" aria-label=\"Добавить инвойс\" class=\"sr-only\" data-kid=\"1-6-2-1\" data-name=\"invoice file upload input\" id=\"invoice-upload\" type=\"file\"/>\n            <span class=\"invoice-screen__inter-tight absolute left-[12px] top-[12px] h-[20px] w-[140px] text-[14px] font-normal leading-5\" data-kid=\"1-6-2-2\" data-name=\"invoice upload label text\">\n                Добавить инвойс\n            </span>\n            <span class=\"invoice-screen__inter-tight absolute left-[12px] top-[36px] h-[12px] w-[140px] text-[10px] font-normal leading-3 text-[rgba(28,16,68,0.4)]\" data-kid=\"1-6-2-3\" data-name=\"invoice file constraints text\">\n                PDF до 15 Мб\n            </span>\n            <img alt=\"\" aria-hidden=\"true\" class=\"absolute left-[133px] top-[89px] h-[14px] w-[14px]\" data-kid=\"1-6-2-4\" data-name=\"add plus icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/add-plus.svg\"/>\n        </label>\n        <label class=\"absolute left-[184px] top-[524px] block h-[120px] w-[164px] rounded-[12px] bg-[rgba(28,16,68,0.05)]\" data-kid=\"1-6-3\" data-name=\"contract file upload drop zone\" for=\"contract-upload\">\n            <input accept=\"application/pdf\" aria-label=\"Добавить контракт\" class=\"sr-only\" data-kid=\"1-6-3-1\" data-name=\"contract file upload input\" id=\"contract-upload\" type=\"file\"/>\n            <span class=\"invoice-screen__inter-tight absolute left-[12px] top-[12px] h-[20px] w-[140px] text-[14px] font-normal leading-5\" data-kid=\"1-6-3-2\" data-name=\"contract upload label text\">\n                Добавить контракт\n            </span>\n            <span class=\"invoice-screen__inter-tight absolute left-[12px] top-[36px] h-[12px] w-[140px] text-[10px] font-normal leading-3 text-[rgba(28,16,68,0.4)]\" data-kid=\"1-6-3-3\" data-name=\"contract file constraints text\">\n                PDF до 15 Мб\n            </span>\n            <img alt=\"\" aria-hidden=\"true\" class=\"absolute left-[133px] top-[89px] h-[14px] w-[14px]\" data-kid=\"1-6-3-4\" data-name=\"add plus icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/add-plus.svg\"/>\n        </label>\n        <label class=\"absolute left-[12px] top-[668px] block h-[25px] w-[250px]\" data-kid=\"1-6-4\" data-name=\"no documents checkbox input group\" for=\"no-documents\">\n            <input aria-label=\"У меня нет документов\" class=\"sr-only\" data-kid=\"1-6-4-1\" data-name=\"no documents checkbox input\" id=\"no-documents\" type=\"checkbox\"/>\n            <span aria-hidden=\"true\" class=\"absolute left-0 top-0 h-[25px] w-[25px] rounded-[6px] border border-[rgba(35,26,65,0.1)] bg-transparent\" data-kid=\"1-6-4-2\" data-name=\"checkbox visual box\">\n            </span>\n            <span class=\"invoice-screen__inter-tight absolute left-[32px] top-[2px] h-[20px] whitespace-nowrap text-[14px] font-normal leading-5\" data-kid=\"1-6-4-3\" data-name=\"no documents checkbox label text\">\n                У меня нет документов\n            </span>\n        </label>\n        <button aria-label=\"Продолжить\" class=\"absolute left-[12px] top-[716px] h-[52px] w-[336px] rounded-[8px] border-0 bg-[#5b26fc] p-0 text-left\" data-kid=\"1-6-5\" data-name=\"form submission continue button\" type=\"submit\">\n            <span class=\"invoice-screen__inter-tight absolute left-[20px] top-[18px] h-[16px] text-[16px] font-medium leading-4 text-white\" data-kid=\"1-6-5-1\" data-name=\"button label text\">\n                Продолжить\n            </span>\n            <img alt=\"\" aria-hidden=\"true\" class=\"absolute left-[301px] top-[19px] h-[14px] w-[14px]\" data-kid=\"1-6-5-2\" data-name=\"continue arrow icon\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/continue-arrow.svg\"/>\n        </button>\n    </form>\n</main>\n",
