# VF-2: Интеграция с Диадоком для ЭДО
# Документация: https://developer.kontur.ru/doc/diadoc-api

# Включение/выключение интеграции с Diadoc
DIADOC_ENABLED=false

# URL API Diadoc (по умолчанию: https://diadoc-api.kontur.ru)
DIADOC_API_URL=https://diadoc-api.kontur.ru

# Ключ разработчика (ddauth_api_client_id) - GUID, уникальный идентификатор интегратора
# Получить можно в личном кабинете разработчика Диадока
DIADOC_API_CLIENT_ID=

# Авторизационный токен (ddauth_token)
# Либо используйте логин/пароль для автоматического получения токена
DIADOC_AUTH_TOKEN=

# Логин для аутентификации (если токен не указан)
DIADOC_LOGIN=

# Пароль для аутентификации (если токен не указан)
DIADOC_PASSWORD=

# ID ящика организации (BoxId)
# Можно получить через GetMyOrganizations API
DIADOC_BOX_ID=

# Таймаут запросов в миллисекундах (по умолчанию: 60000)
DIADOC_TIMEOUT=60000

# Интервал проверки статусов документов (cron формат, по умолчанию: каждые 5 минут)
DIADOC_STATUS_CHECK_INTERVAL=*/5 * * * *

# Количество повторных попыток при временных ошибках (по умолчанию: 3)
DIADOC_MAX_RETRIES=3

# Настройки безопасности webhook
# Секретный ключ для проверки подлинности webhook запросов
DIADOC_WEBHOOK_SECRET=

# Разрешённые IP-адреса для webhook (через запятую, поддерживается CIDR)
DIADOC_WEBHOOK_ALLOWED_IPS=

# Максимальный возраст webhook запроса в секундах (по умолчанию: 300)
DIADOC_WEBHOOK_MAX_AGE_SECONDS=300

# Включить валидацию структуры webhook payload (по умолчанию: true)
DIADOC_WEBHOOK_VALIDATE_PAYLOAD=true
