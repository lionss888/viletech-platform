# Copy to ~/.vedy_bot/env (chmod 600). Do not commit real values.
# Used by: pre-commit fail notify, post-commit/push/merge, make check-deploy-secrets, deploy.

MGMT_NOTIFY_TOKEN=REPLACE_WITH_BOT_TOKEN
MGMT_NOTIFY_CHAT_ID=REPLACE_WITH_CHAT_ID

# Optional aliases (same effect as above):
# TELEGRAM_INTAKE_TOKEN=...
# TELEGRAM_INTAKE_CHAT_IDS=...
